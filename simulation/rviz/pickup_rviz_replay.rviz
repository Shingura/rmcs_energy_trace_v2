Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 38; 42; 48
    Fixed Frame: pickup_world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 0.2
      Plane Cell Count: 20
      Color: 110; 115; 120
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Arm
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /pickup/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: pickup
    - Class: rviz_default_plugins/MarkerArray
      Name: Pickup Scene
      Enabled: true
      Topic:
        Value: /pickup/scene
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: Coordinate Frames
      Enabled: false
      Show Axes: true
      Show Names: true
      Show Arrows: false
      Marker Scale: 0.15
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: pickup_world
      Distance: 2.4
      Pitch: 0.35
      Yaw: 4.05
      Focal Point:
        X: 0
        Y: -0.25
        Z: 0.65
Window Geometry:
  Width: 1280
  Height: 900
